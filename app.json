{
  "expo": {
    "name": "Beam",
    "slug": "beem-res",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beemres",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EEEDF0",
          "dark": {
            "backgroundColor": "#EEEDF0"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Beam needs camera access to scan loyalty QR codes."
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Beam needs access to your photos so you can share them on the Media tab.",
          "cameraPermission": "Beam needs camera access so you can take a photo to share on the Media tab."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Beam needs your location to set your delivery address and, for drivers, to share your live position with the customer during delivery."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
