DATABASE_URL="postgresql://restaurant:restaurant@localhost:5433/restaurant_app?schema=public"
PORT=4000
JWT_SECRET="change-me-dev-secret"
JWT_EXPIRES_IN="30d"
JWT_STAFF_EXPIRES_IN="7d"

# OTP delivery — "console" logs the code to the server terminal (dev default, no cost, no setup).
# Switch to "whatsapp" once the Meta WhatsApp Business account is verified.
OTP_PROVIDER="console"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# TESTING ONLY — lets any scan through without a real purchase behind it. Must be "false" (or
# removed) before real customers use the app, otherwise the loyalty QR has zero fraud protection.
LOYALTY_SKIP_PURCHASE_CHECK="false"

# Cloudflare R2 (S3-compatible) — stores all uploaded/generated images.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
